{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build and run cpp (powershell)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "& { g++ -g \"${file}\" -o \"${workspaceFolder}\\output\\${fileBasenameNoExtension}.exe\"; if ($LASTEXITCODE -eq 0) { & \"${workspaceFolder}\\output\\${fileBasenameNoExtension}.exe\" } }"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}
